---
// Footer — matches Dentara Framer template
// 4-column links grid, social icons, copyright bar
---

<footer class="footer">
  <div class="footer__inner container">

    <!-- Top: Logo + cols + newsletter -->
    <div class="footer__top">
      <!-- Brand -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Dentara home">
          <div class="footer__logo-icon">
            <img src="/favicon.svg" alt="" width="48" height="48" style="width: 48px; height: 48px; object-fit: contain;" />
          </div>
          <span class="footer__logo-text">Dentara</span>
        </a>
        <p class="footer__tagline">
          Modern dental care focused on comfort, precision, and healthier smiles for every patient.
        </p>

        <!-- Social Icons -->
        <div class="footer__social" aria-label="Social media links">
          <!-- Facebook -->
          <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="Facebook">
