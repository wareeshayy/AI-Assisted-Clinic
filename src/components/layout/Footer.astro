            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <div class="footer__cols">
        <div class="footer__col">
          <h3 class="footer__col-title">Company</h3>
          <ul class="footer__col-links">
            <li><a href="/about">About Us</a></li>
            <li><a href="/team">Our Team</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/booking">Book an Appointment</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <h3 class="footer__col-title">Services</h3>
          <ul class="footer__col-links">
            <li><a href="/services/teeth-whitening">Teeth Whitening</a></li>
            <li><a href="/services/orthodontics">Orthodontics</a></li>
            <li><a href="/services/cosmetic-dentistry">Cosmetic Dentistry</a></li>
            <li><a href="/services/emergency-care">Emergency Care</a></li>
            <li><a href="/services/pediatric-care">Pediatric Care</a></li>
            <li><a href="/services/general-checkup">General Checkup</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <h3 class="footer__col-title">Hours</h3>
          <ul class="footer__col-links footer__hours">
            <li><span>Mon – Fri</span><span>8:00 AM – 7:00 PM</span></li>
            <li><span>Saturday</span><span>9:00 AM – 5:00 PM</span></li>
            <li><span>Sunday</span><span>Closed</span></li>
          </ul>
        </div>

        <div class="footer__col">
          <h3 class="footer__col-title">Contact</h3>
          <ul class="footer__col-links">
            <li><a href="tel:+923001234567">+92 300 1234567</a></li>
            <li><a href="mailto:hello@dentara.com">hello@dentara.com</a></li>
            <li>Suite 401, Shahrah-e-Faisal<br/>Karachi, Pakistan</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="footer__divider" aria-hidden="true"></div>

    <!-- Bottom bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">© {new Date().getFullYear()} Dentara. All rights reserved.</p>
      <div class="footer__legal">
        <a href="/legal/privacy-policy">Privacy Policy</a>
        <a href="/legal/terms-and-conditions">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>

<style>
.footer {
  background-color: var(--color-primary);
  color: rgba(255,255,255,0.75);
}

.footer__inner {
  padding-top: var(--space-20);
  padding-bottom: var(--space-8);
}

/* ---- Top ---- */
.footer__top {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: var(--space-16);
  margin-bottom: var(--space-12);
}

/* ---- Brand ---- */
.footer__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  margin-bottom: var(--space-5);
}

.footer__logo-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.footer__logo-text {
  font-family: var(--font-heading);
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-white);
}

.footer__tagline {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--space-6);
  max-width: 240px;
}

/* ---- Social ---- */
.footer__social {
  display: flex;
  gap: var(--space-3);
}

.footer__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
}

.footer__social-link:hover {
  color: var(--color-white);
  border-color: rgba(255,255,255,0.4);
  background-color: rgba(255,255,255,0.08);
}

/* ---- Columns ---- */
.footer__cols {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-8);
}

.footer__col-title {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-white);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  margin-bottom: var(--space-5);
}

.footer__col-links {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.footer__col-links li {
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  color: rgba(255,255,255,0.6);
}

.footer__col-links a {
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer__col-links a:hover {
  color: var(--color-white);
}

.footer__hours li {
  display: flex;
  justify-content: space-between;
  gap: var(--space-4);
}

/* ---- Divider ---- */
.footer__divider {
  height: 1px;
  background-color: var(--color-border-teal);
  opacity: 0.2;
  margin-bottom: var(--space-6);
}

/* ---- Bottom ---- */
.footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.footer__copyright {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.5);
}

.footer__legal {
  display: flex;
  gap: var(--space-6);
}

.footer__legal a {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer__legal a:hover {
  color: var(--color-white);
}

/* ---- Responsive ---- */
@media (max-width: 1024px) {
  .footer__top {
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  .footer__cols {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer__tagline {
    max-width: 100%;
  }
}

@media (max-width: 809px) {
  .footer__cols {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .footer__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
}

@media (max-width: 480px) {
  .footer__cols {
    grid-template-columns: 1fr;
  }
}
</style>
