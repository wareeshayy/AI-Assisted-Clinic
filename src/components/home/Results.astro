<section class="results" aria-labelledby="results-title">
  <div class="results__inner">
    <div class="results__content">
      <header class="results__header">
        <div class="results__eyebrow">
          <span>Result</span><span class="results__line" aria-hidden="true"></span>
        </div>
        <h2 id="results-title">Inspiring Radiant, Healthy Smiles Forever</h2>
        <p>Take care of your smile and look great doing it! Enjoy safe, modern, personalized care for a brighter, healthier you.</p>
      </header>

      <a class="results__button" href="/booking">
        <span>Book Consultation</span>
        <span class="results__button-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
            <path d="M4.5 11h13M12 5.5l5.5 5.5-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>

    <div class="results__visual">
      <div class="results__comparison" style="--comparison-position:50%">
        <img
          class="results__image results__image--before"
          src="https://framerusercontent.com/images/uxldkk4ATtXoQtnnDS2WbHLEids.png?width=1440&height=1060"
          alt="Smile before cosmetic dental treatment"
          width="1440"
          height="1060"
          loading="lazy"
          draggable="false"
        />
        <div class="results__after-clip" aria-hidden="true">
          <img
            class="results__image results__image--after"
            src="https://framerusercontent.com/images/vxiiAmVEdqKfMcEagPanNp6j3w.png?width=1440&height=1060"
            alt=""
            width="1440"
            height="1060"
            loading="lazy"
            draggable="false"
          />
        </div>

        <span class="results__divider" aria-hidden="true"></span>
        <span class="results__drag" aria-hidden="true">Drag</span>
        <span class="results__label results__label--before" aria-hidden="true">Before</span>
        <span class="results__label results__label--after" aria-hidden="true">After</span>

        <input
          class="results__range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Compare the smile before and after treatment"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const initializeComparisons = () => {
    document.querySelectorAll('.results__comparison').forEach((comparison) => {
      if (!(comparison instanceof HTMLElement) || comparison.dataset.ready === 'true') return;
      const range = comparison.querySelector('.results__range');
      if (!(range instanceof HTMLInputElement)) return;

      const update = () => comparison.style.setProperty('--comparison-position', `${range.value}%`);
      range.addEventListener('input', update);
      update();
      comparison.dataset.ready = 'true';
    });
  };

  initializeComparisons();
  document.addEventListener('astro:page-load', initializeComparisons);
</script>

<style>
