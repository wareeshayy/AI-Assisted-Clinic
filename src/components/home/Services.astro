---
// Services Section — Reads from Astro content collections
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const featuredServices = allServices
  .filter(s => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section class="services-section section" style="background-color: var(--color-accent);">
  <div class="container services__container">
    <!-- Header -->
    <div class="services__header">
      <div class="services__header-left">
        <div class="section-tag-pill">
          <span>Our Service</span>
          <span class="tag-line-icon" aria-hidden="true">
            <svg width="50" height="8" viewBox="0 0 50 8" fill="none">
              <path d="M 1.5 3.167 C 1.224 3.167 1 3.39 1 3.667 C 1 3.943 1.224 4.167 1.5 4.167 L 1.5 3.667 Z M 43.333 3.667 C 43.333 5.139 44.527 6.333 46 6.333 C 47.473 6.333 48.667 5.139 48.667 3.667 C 48.667 2.194 47.473 1 46 1 C 44.527 1 43.333 2.194 43.333 3.667 Z M 1.5 3.667 L 1.5 4.167 L 46 4.167 L 46 3.667 L 46 3.167 L 1.5 3.167 Z" fill="currentColor"/>
            </svg>
          </span>
        </div>
        <h2 class="services__heading reveal reveal-delay-2">
          Comprehensive Dental Services
        </h2>
      </div>
      <p class="services__subtitle reveal reveal-delay-3">
        From routine care to advanced procedures, we offer everything your smile needs under one roof.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="services__grid">
      {featuredServices.map((service, i) => (
        <article class={`service-card reveal-scale reveal-delay-${(i % 3) + 1}`}>
          <a href={`/services/${service.slug}`} class="service-card__link" aria-label={`Learn about ${service.data.title}`}>
            <!-- Image Wrapper -->
            <div class="service-card__image-wrapper">
              <img
                src={service.data.image}
                alt={service.data.imageAlt}
                class="service-card__image"
                width="480"
                height="320"
                loading="lazy"
              />
              <div class="service-card__overlay" aria-hidden="true"></div>
            </div>

            <!-- Content -->
            <div class="service-card__content">
              <h3 class="service-card__title">{service.data.title}</h3>
              <div class="btn btn-primary service-card__btn">
                <span class="btn-text">Get This Service</span>
                <span class="btn-icon-circle" aria-hidden="true">
                  <span class="btn-arrow btn-arrow--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </span>
                  <span class="btn-arrow btn-arrow--clone">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </span>
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- View All Button -->
    <div class="services__footer reveal reveal-delay-4">
      <a href="/services" class="btn btn-outline btn-lg">
        <span class="btn-text">View All Services</span>
      </a>
    </div>
  </div>
</section>

<style>
.services-section {
  padding-block: 120px;
  background: var(--color-accent);
}

.services__container {
  max-width: 1640px;
  padding-inline: 100px;
}

.services__header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  gap: 64px;
  margin-bottom: 48px;
}

.services__header-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  max-width: 520px;
}

.section-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: var(--font-body);
  font-size: 1.125rem;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--color-white);
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 0;
  width: fit-content;
}

.services__heading {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 500;
  line-height: 1.04;
  letter-spacing: -0.04em;
  color: var(--color-white);
}

.services__subtitle {
  width: 100%;
  max-width: 345px;
  font-size: 1.125rem;
  color: var(--color-white);
  line-height: 1.6;
}

/* Grid */
.services__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: var(--space-12);
}

/* Card */
.service-card {
  border-radius: 18px;
  overflow: hidden;
  background: var(--color-white);
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

.service-card__link {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 12px;
  text-decoration: none;
}

.service-card__image-wrapper {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1.31387;
  border-radius: 18px;
}

.service-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.service-card:hover .service-card__image {
  transform: scale(1.06);
}

.service-card__overlay {
  display: none;
}

.service-card__content {
  padding: 20px 0 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 20px;
  flex: 1;
}

.service-card__title {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 500;
  line-height: 1.5;
  color: var(--color-primary);
}

.service-card__btn {
  align-self: flex-start;
}

.services__footer {
  display: flex;
  justify-content: center;
}

@media (max-width: 1024px) {
  .services-section {
    padding-block: 60px;
  }

  .services__container {
    padding-inline: 40px;
  }

  .services__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .services__header-left,
  .services__subtitle {
    max-width: 415px;
  }

  .services__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 809px) {
  .services-section {
    padding-block: 40px;
  }

  .services__container {
    padding-inline: 20px;
  }

  .services__heading {
    font-size: 1.75rem;
  }

  .section-tag-pill,
  .services__subtitle {
    font-size: 1rem;
  }

  .services__grid {
    grid-template-columns: 1fr;
  }
}
</style>
