              </svg>
            </span>
            <span>Certified dental specialists</span>
          </li>

          <li class="who__feature-item">
            <span class="who__feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M 6.887 7.793 C 6.619 7.925 6.318 8 6 8 C 4.896 8 4 7.104 4 6 C 4 4.896 4.896 4 6 4 C 7.104 4 8 4.896 8 6 C 8 6.37 7.899 6.716 7.725 7.013 L 9.173 8.409 C 9.81 7.906 10.583 7.57 11.429 7.464 L 11.429 6.286 C 11.429 5.97 11.685 5.714 12 5.714 L 13.143 5.714 L 13.143 4.571 C 13.143 4.256 13.399 4 13.714 4 C 14.03 4 14.286 4.256 14.286 4.571 L 14.286 6.286 C 14.286 6.601 14.03 6.857 13.714 6.857 L 12.571 6.857 L 12.571 7.464 C 13.906 7.631 15.063 8.374 15.784 9.436 L 16.066 9.271 C 16.023 9.109 16 8.938 16 8.762 C 16 7.658 16.896 6.762 18 6.762 C 19.104 6.762 20 7.658 20 8.762 C 20 9.866 19.104 10.762 18 10.762 C 17.485 10.762 17.015 10.567 16.661 10.247 C 16.567 10.302 16.444 10.374 16.303 10.456 C 16.477 10.938 16.571 11.458 16.571 12 C 16.571 13.019 16.237 13.961 15.673 14.722 L 17.161 16.184 C 17.416 16.066 17.701 16 18 16 C 19.104 16 20 16.896 20 18 C 20 19.104 19.104 20 18 20 C 16.896 20 16 19.104 16 18 C 16 17.612 16.111 17.25 16.302 16.943 L 14.882 15.547 C 14.235 16.074 13.441 16.427 12.571 16.536 L 12.571 17.714 C 12.571 18.03 12.315 18.286 12 18.286 C 11.685 18.286 11.429 18.03 11.429 17.714 L 11.429 16.536 C 10.145 16.375 9.025 15.682 8.3 14.683 L 7.955 14.869 C 7.985 15.005 8 15.147 8 15.292 C 8 16.396 7.104 17.292 6 17.292 C 4.896 17.292 4 16.396 4 15.292 C 4 14.188 4.896 13.292 6 13.292 C 6.547 13.292 7.042 13.512 7.403 13.867 L 7.749 13.682 C 7.542 13.162 7.429 12.594 7.429 12 C 7.429 10.955 7.779 9.993 8.37 9.222 Z" fill="#0F766E"/>
              </svg>
            </span>
            <span>Advanced digital technology</span>
          </li>
        </ul>

        <!-- White Pill Button -->
        <a href="/about" class="btn btn-outline who__btn-learn">
          <span class="btn-text">Learn More</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const whoVideo = document.getElementById('whoVideo') as HTMLVideoElement | null;
  const toggleBtn = document.getElementById('videoToggleBtn');
  if (whoVideo && toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      if (whoVideo.paused) {
        whoVideo.play();
        toggleBtn.style.opacity = '0.35';
      } else {
        whoVideo.pause();
        toggleBtn.style.opacity = '1';
      }
    });
  }
</script>

<style>
.who-section {
  padding-top: var(--space-20);
  padding-bottom: var(--space-20);
  background: var(--color-white);
}

.who__container {
  max-width: 1640px;
  padding-inline: 100px;
}

/* Header Row: Left Title vs Right Subtitle */
.who__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 64px;
  margin-bottom: 48px;
}

.who__header-left {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  max-width: 520px;
}

.section-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: var(--font-body);
  font-size: 1.125rem;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--color-primary);
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 0;
  width: fit-content;
}

.who__heading {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 500;
  line-height: 1.04;
  letter-spacing: -0.04em;
  color: var(--color-primary);
}

.who__header-right {
  width: 100%;
  max-width: 380px;
}

.who__subtitle {
  font-family: var(--font-body);
  font-size: 1.125rem;
  color: var(--color-teal-mid);
  line-height: 1.6;
}

/* Grid: Video Left, Card Right */
.who__grid {
  display: grid;
  grid-template-columns: minmax(0, 780px) 32%;
  justify-content: space-between;
  gap: 40px;
  align-items: start;
}

/* Video */
.who__video-container {
  position: relative;
  width: 100%;
  max-width: 780px;
  aspect-ratio: 1.625;
  border-radius: 18px;
  overflow: hidden;
  background: var(--color-bg-light);
}

.who__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.who__video-toggle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 52px;
  height: 52px;
  cursor: pointer;
  border-radius: 50%;
  transition: transform 0.25s ease, opacity 0.25s ease;
  z-index: 2;
}

.who__video-toggle:hover {
  transform: translate(-50%, -50%) scale(1.08);
}

/* Card */
.who__card {
  background: var(--color-white);
  border: 1px solid var(--color-border-blue);
  border-radius: 18px;
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 0;
  align-self: stretch;
}

.who__card-title {
  font-family: var(--font-heading);
  font-size: 1.875rem;
  font-weight: 500;
  line-height: 1.25;
  color: var(--color-primary);
  letter-spacing: 0;
  margin-bottom: 32px;
}

.who__feature-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 83px;
}

.who__feature-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-size: 1.125rem;
  color: var(--color-teal-mid);
}

.who__feature-icon {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.who__btn-learn {
  width: 100%;
  justify-content: center;
  background: #ffffff;
  border: 1.5px solid var(--color-border-blue);
  padding: 14px 28px;
  font-size: 0.9375rem;
}

@media (max-width: 1439px) and (min-width: 810px) {
  .who__container {
    padding-inline: 40px;
  }

  .who__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .who__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .who__video-container,
  .who__header-left,
  .who__header-right {
    max-width: none;
  }

  .who__card {
    align-self: auto;
  }
}

@media (max-width: 809px) {
  .who-section {
    padding-block: var(--space-16);
  }

  .who__container {
    padding-inline: 20px;
  }

  .who__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 32px;
  }

  .who__header-left,
  .who__header-right {
    max-width: none;
  }

  .who__heading {
    max-width: 12ch;
    font-size: 2rem;
    line-height: 1.08;
  }

  .section-tag-pill,
  .who__subtitle,
  .who__feature-item {
    font-size: 1rem;
  }

  .who__card {
    width: 100%;
    padding: 28px 24px;
    border-radius: 16px;
  }

  .who__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .who__video-container {
    width: 100%;
    max-width: none;
    aspect-ratio: 16 / 10;
    min-height: 0;
    border-radius: 16px;
  }

  .who__video-toggle {
    width: 56px;
    height: 56px;
  }

  .who__card-title {
    margin-bottom: 28px;
    font-size: 1.625rem;
  }

  .who__feature-list {
    gap: 18px;
    margin-bottom: 32px;
  }

  .hidden-mobile {
    display: none;
  }
}
</style>
