---
// Who We Are Section — Exact pixel-match to dentara.framer.ai
---

<section class="who-section section">
  <div class="container who__container">
    <!-- Header Row -->
    <div class="who__header">
      <!-- Left Side: Tag + Heading -->
      <div class="who__header-left">
        <div class="section-tag-pill">
          <span>WHO WE ARE</span>
          <span class="tag-line-icon" aria-hidden="true">
            <svg width="50" height="8" viewBox="0 0 50 8" fill="none">
              <path d="M 1.5 3.167 C 1.224 3.167 1 3.39 1 3.667 C 1 3.943 1.224 4.167 1.5 4.167 L 1.5 3.667 Z M 43.333 3.667 C 43.333 5.139 44.527 6.333 46 6.333 C 47.473 6.333 48.667 5.139 48.667 3.667 C 48.667 2.194 47.473 1 46 1 C 44.527 1 43.333 2.194 43.333 3.667 Z M 1.5 3.667 L 1.5 4.167 L 46 4.167 L 46 3.667 L 46 3.167 L 1.5 3.167 Z" fill="#052927"/>
            </svg>
          </span>
        </div>

        <h2 class="who__heading">
          What Sets Our Dental<br class="hidden-mobile" />
          Care Apart?
        </h2>
      </div>

      <!-- Right Side: Subtitle paragraph -->
      <div class="who__header-right">
        <p class="who__subtitle">
          We deliver trusted dental care focused on comfort, precision, and healthier smiles for every patient.
        </p>
      </div>
    </div>

    <!-- Content: 2-Column Grid (Video + Card) -->
    <div class="who__grid">
      <!-- Left: Video Player with Centered Toggle Button -->
      <div class="who__video-container">
        <video
          class="who__video"
          id="whoVideo"
          src="https://framerusercontent.com/assets/XhUMyGQZXA2wZZrfvLm18AiCHXc.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Dentara clinic video tour"
        ></video>
        <!-- Overlay Circular Play/Pause Button -->
        <button class="who__video-toggle" id="videoToggleBtn" aria-label="Toggle video playback">
          <img
            src="https://framerusercontent.com/images/3UsOtFy34yqgwrIxt1uu10dQU.svg"
            alt=""
            width="72"
            height="72"
            loading="lazy"
            aria-hidden="true"
          />
        </button>
      </div>

      <!-- Right: Feature Card -->
      <div class="who__card">
        <h3 class="who__card-title">
          Modern Dentistry for Every Smile
        </h3>

        <ul class="who__feature-list">
          <li class="who__feature-item">
            <span class="who__feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 15 15" fill="none">
