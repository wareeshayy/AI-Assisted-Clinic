---
// Our Experience / Benefits Section — Matches dentara.framer.ai
const benefits = [
  {
    title: 'Personalised Dental Care',
    description: 'Receive customized treatments designed for your smile goals and oral health needs.',
    svg: `
      <path d="M40 43.9998V30C40 27.7908 38.2092 26 36 26L28 25.9998L24 29.9998L20 25.9998L12 26C9.79084 26 8 27.7908 8 30V43.9998" stroke="#F94B25" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M31 13V11C31 7.134 27.866 4 24 4C20.134 4 17 7.134 17 11V13C17 16.866 20.134 20 24 20C27.866 20 31 16.866 31 13Z" stroke="#F94B25" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M32 32V38M35 35H29" stroke="#F94B25" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    `,
  },
  {
    title: 'Advanced Dental Technology',
    description: 'Modern tools and diagnostics ensure safe, accurate treatments.',
    svg: `
      <path d="M10 32L20 26M28 22L38 16M24 10V20M24 28V38M10 16L20 22M28 26L38 32" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M41 18V29M27 40L38 34M9 35L21 40M7 30V18M10 13L21 8M38 13L27 8" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M24 10C25.6569 10 27 8.65685 27 7C27 5.34315 25.6569 4 24 4C22.3431 4 21 5.34315 21 7C21 8.65685 22.3431 10 24 10Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M24 44C25.6569 44 27 42.6569 27 41C27 39.3431 25.6569 38 24 38C22.3431 38 21 39.3431 21 41C21 42.6569 22.3431 44 24 44Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M7 18C8.65685 18 10 16.6569 10 15C10 13.3431 8.65685 12 7 12C5.34315 12 4 13.3431 4 15C4 16.6569 5.34315 18 7 18Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M41 18C42.6569 18 44 16.6569 44 15C44 13.3431 42.6569 12 41 12C39.3431 12 38 13.3431 38 15C38 16.6569 39.3431 18 41 18Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M41 36C42.6569 36 44 34.6569 44 33C44 31.3431 42.6569 30 41 30C39.3431 30 38 31.3431 38 33C38 34.6569 39.3431 36 41 36Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M7 36C8.65685 36 10 34.6569 10 33C10 31.3431 8.65685 30 7 30C5.34315 30 4 31.3431 4 33C4 34.6569 5.34315 36 7 36Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
      <path d="M24 19.5L28 21.75V26.25L24 28.5L20 26.25V21.75L24 19.5Z" stroke="#429C8C" stroke-width="3" stroke-linejoin="round"/>
    `,
  },
  {
    title: 'Comfortable Experience',
    description: 'Enjoy comfortable dental care with a gentle, patient-first approach.',
    svg: `
      <path d="M18 39C11.0991 37.4468 6 32.3872 6 24C6 14.0589 22 4 22 4C22 4 30.377 9.29588 35 16" stroke="#145AFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M34 30C30.9968 32.0028 26.0044 36.99 22 44M26.0044 37.9914C20.6708 26.256 33.012 21.9686 42 22.0002C42 31.9828 38.0068 43.2126 26.0044 37.9914Z" stroke="#145AFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    `,
  },
];
---

<section class="benefits-section section">
  <div class="container benefits__container">
    <!-- Header -->
    <div class="benefits__header">
      <div class="benefits__header-left">
        <div class="section-tag-pill">
          <span>Our Experience</span>
          <span class="tag-line-icon" aria-hidden="true">
            <svg width="50" height="8" viewBox="0 0 50 8" fill="none">
              <path d="M 1.5 3.167 C 1.224 3.167 1 3.39 1 3.667 C 1 3.943 1.224 4.167 1.5 4.167 L 1.5 3.667 Z M 43.333 3.667 C 43.333 5.139 44.527 6.333 46 6.333 C 47.473 6.333 48.667 5.139 48.667 3.667 C 48.667 2.194 47.473 1 46 1 C 44.527 1 43.333 2.194 43.333 3.667 Z M 1.5 3.667 L 1.5 4.167 L 46 4.167 L 46 3.667 L 46 3.167 L 1.5 3.167 Z" fill="#052927"/>
            </svg>
          </span>
        </div>
        <h2 class="benefits__heading reveal reveal-delay-2">
          Benefits You Get<br />with Dentara
        </h2>
      </div>
      <p class="benefits__subtitle reveal reveal-delay-3">
        We provide advanced dental treatments designed for confidence, comfort, and lasting oral wellness.
      </p>
    </div>

    <!-- Content: 3 horizontal benefit columns, followed by the section image -->
    <div class="benefits__grid">
      <!-- 3 Benefit Columns -->
      <div class="benefits__cards-stack">
        {benefits.map((b, i) => (
          <div class={`benefit-card reveal reveal-delay-${i + 2}`}>
            <div class="benefit-card__icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" set:html={b.svg}></svg>
            </div>
            <div class="benefit-card__text">
              <h3 class="benefit-card__title">{b.title}</h3>
              <p class="benefit-card__desc">{b.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Visual Image -->
      <div
        class="benefits__image-container"
        data-benefits-image-reveal
        style="--benefits-cover-scale: 1; position: relative; aspect-ratio: 2.94; overflow: hidden; border-radius: 24px;"
      >
        <img
          src="https://framerusercontent.com/images/9g4sWpBOyTRQnNVqIhjoZ0E0A.png"
          alt="Two dentists examining dental x-rays"
          class="benefits__image"
          width="1800"
          height="930"
          loading="lazy"
        />
        <span
          class="benefits__image-cover benefits__image-cover--left"
          aria-hidden="true"
          style="position: absolute; inset: 0 auto 0 0; z-index: 2; width: 50.1%; background: #fff; transform: scaleX(var(--benefits-cover-scale)); transform-origin: left center; pointer-events: none;"
        ></span>
        <span
          class="benefits__image-cover benefits__image-cover--right"
          aria-hidden="true"
          style="position: absolute; inset: 0 0 0 auto; z-index: 2; width: 50.1%; background: #fff; transform: scaleX(var(--benefits-cover-scale)); transform-origin: right center; pointer-events: none;"
        ></span>
      </div>
    </div>
  </div>
</section>

<script>
  const revealImage = document.querySelector<HTMLElement>('[data-benefits-image-reveal]');

  if (revealImage) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let revealFrame = 0;

    const updateImageReveal = () => {
      revealFrame = 0;

      if (reducedMotion.matches) {
        revealImage.style.setProperty('--benefits-cover-scale', '0');
        return;
      }

      const bounds = revealImage.getBoundingClientRect();
      const revealStart = window.innerHeight * 0.52;
      const revealEnd = window.innerHeight * 0.18;
      const progress = Math.min(1, Math.max(0, (revealStart - bounds.top) / (revealStart - revealEnd)));
      revealImage.style.setProperty('--benefits-cover-scale', String(1 - progress));
    };

    const requestRevealUpdate = () => {
      if (!revealFrame) revealFrame = window.requestAnimationFrame(updateImageReveal);
    };

    revealImage.style.setProperty('--benefits-cover-scale', '1');
    updateImageReveal();
    window.addEventListener('scroll', requestRevealUpdate, { passive: true });
    window.addEventListener('resize', requestRevealUpdate, { passive: true });
    reducedMotion.addEventListener('change', requestRevealUpdate);
  }
</script>

<style>
.benefits-section {
  background: var(--color-white);
  padding-bottom: 160px;
}

.benefits__container {
  max-width: 1640px;
  padding-inline: 100px;
}

.benefits__header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  gap: 64px;
  margin-bottom: 48px;
}

.benefits__header-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  max-width: 520px;
}

.section-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: var(--font-body);
  font-size: 1.125rem;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--color-primary);
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 0;
  width: fit-content;
}

.benefits__heading {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 500;
  line-height: 1.04;
  letter-spacing: -0.04em;
  color: var(--color-primary);
}

.benefits__subtitle {
  width: 100%;
  max-width: 380px;
  font-size: 1.125rem;
  color: var(--color-teal-mid);
  line-height: 1.6;
}

/* Grid */
.benefits__grid {
  display: flex;
  flex-direction: column;
  gap: 28px;
  align-items: center;
}

/* Cards */
.benefits__cards-stack {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: 100%;
}

.benefit-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 48px;
  min-height: 266px;
  padding: 32px;
  border-right: 1px solid var(--color-border-teal);
}

.benefit-card:first-child {
  padding-left: 0;
}

.benefit-card__icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.benefit-card__text {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.benefit-card__title {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--color-primary);
  line-height: 1.5;
}

.benefit-card__desc {
  max-width: 410px;
  font-size: 1.125rem;
  color: var(--color-teal-mid);
  line-height: 1.5;
}

/* Image */
.benefits__image-container {
  --benefits-cover-scale: 0;
  position: relative;
  width: 100%;
  aspect-ratio: 2.94;
  border-radius: 24px;
  overflow: hidden;
  background: var(--color-bg-light);
}

.benefits__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.benefits__image-cover {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 50.1%;
  background: var(--color-white);
  pointer-events: none;
  will-change: transform;
  transition: transform 60ms linear;
}

.benefits__image-cover--left {
  left: 0;
  transform: scaleX(var(--benefits-cover-scale));
  transform-origin: left center;
}

.benefits__image-cover--right {
  right: 0;
  transform: scaleX(var(--benefits-cover-scale));
  transform-origin: right center;
}

@media (max-width: 1439px) and (min-width: 810px) {
  .benefits__container {
    padding-inline: 40px;
  }

  .benefits__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .benefits__header-left,
  .benefits__subtitle {
    max-width: 400px;
  }

  .benefits__cards-stack {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .benefit-card:first-child {
    padding-left: 32px;
  }
}

@media (max-width: 809px) {
  .benefits-section {
    padding-bottom: var(--space-20);
  }

  .benefits__container {
    padding-inline: 20px;
  }

  .benefits__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 32px;
  }

  .benefits__header-left,
  .benefits__subtitle {
    max-width: none;
  }

  .benefits__heading {
    font-size: 2rem;
    line-height: 1.08;
  }

  .section-tag-pill,
  .benefits__subtitle,
  .benefit-card__desc {
    font-size: 1rem;
  }

  .benefits__cards-stack {
    grid-template-columns: 1fr;
  }

  .benefit-card,
  .benefit-card:first-child {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
    min-height: 0;
    gap: 20px;
    padding: 30px 0;
    border-right: 0;
    border-bottom: 1px solid var(--color-border-teal);
  }

  .benefit-card__text {
    gap: 10px;
  }

  .benefit-card__title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .benefit-card:last-child {
    border-bottom: 0;
  }

  .benefits__image-container {
    aspect-ratio: 4 / 3 !important;
    border-radius: 16px !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .benefits__image-cover {
    transform: scaleX(0);
    transition: none;
  }
}
</style>
