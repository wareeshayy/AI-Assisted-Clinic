---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const allTeam = await getCollection('team');
const team = allTeam.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Our Dental Team — Dentara Specialists"
  description="Meet the world-class dentists, orthodontists, and oral health experts dedicated to your smile at Dentara."
>
  <Navbar />
  <main id="main" tabindex="-1">
    <!-- Page Hero -->
    <section class="page-hero">
      <div class="container">
        <div class="page-hero__tag">Dentara Specialists</div>
        <h1 class="page-hero__heading">Meet Our Dental Team</h1>
        <p class="page-hero__subtitle">
          Our team of board-certified clinicians brings decades of combined expertise across cosmetic, restorative, surgical, and preventive dentistry.
        </p>
      </div>
    </section>

    <!-- Team Full Grid -->
    <section class="team-full section">
      <div class="container">
        <div class="team-full__grid">
          {team.map((member) => (
            <article class="doctor-profile">
              <div class="doctor-profile__image-wrapper">
                <img
                  src={member.data.image}
                  alt={member.data.imageAlt}
                  class="doctor-profile__image"
                  width="450"
                  height="520"
                  loading="lazy"
                />
              </div>

              <div class="doctor-profile__info">
                <h2 class="doctor-profile__name">{member.data.name}</h2>
                <p class="doctor-profile__role">{member.data.role}</p>

                {member.data.education && (
                  <p class="doctor-profile__meta">
                    <strong>Education:</strong> {member.data.education}
                  </p>
                )}

                {member.data.experience && (
                  <p class="doctor-profile__meta">
                    <strong>Experience:</strong> {member.data.experience}
                  </p>
                )}

                <div class="doctor-profile__specialties">
                  {member.data.specialties.map((s) => (
                    <span class="specialty-tag">{s}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
.page-hero {
  background-color: var(--color-bg-light);
  padding: calc(var(--nav-height) + var(--space-20)) 0 var(--space-20);
}

.page-hero__tag {
  font-size: var(--text-sm);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  color: var(--color-teal-mid);
  margin-bottom: var(--space-4);
}

.page-hero__heading {
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--color-primary);
  margin-bottom: var(--space-5);
  max-width: 800px;
}

.page-hero__subtitle {
  font-size: var(--text-md);
  color: var(--color-teal-mid);
  line-height: var(--leading-relaxed);
  max-width: 650px;
}

.team-full__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-8);
}

.doctor-profile {
  background: var(--color-white);
  border: 1px solid var(--color-border-teal);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.doctor-profile:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

.doctor-profile__image-wrapper {
  aspect-ratio: 4/5;
  overflow: hidden;
  background: var(--color-bg-light);
}

.doctor-profile__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.doctor-profile:hover .doctor-profile__image {
  transform: scale(1.05);
}

.doctor-profile__info {
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex: 1;
}

.doctor-profile__name {
  font-family: var(--font-heading);
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
}

.doctor-profile__role {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-teal-mid);
}

.doctor-profile__meta {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
}

.doctor-profile__specialties {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: auto;
  padding-top: var(--space-3);
}

.specialty-tag {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-teal-mid);
  background: var(--color-bg-light);
  border: 1px solid var(--color-border-teal);
  border-radius: var(--radius-full);
  padding: 4px 10px;
}

@media (max-width: 1024px) {
  .team-full__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 809px) {
  .team-full__grid {
    grid-template-columns: 1fr;
  }
}
</style>
